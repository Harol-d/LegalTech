# Copie este archivo a `.env` y complete el valor de la clave.
#
#   cp .env.example .env
#
# Nunca versione el archivo `.env` (está en .gitignore).

# Clave de API de Google AI Studio (Gemini): https://aistudio.google.com/apikey
key-Model=

# Modelo de Google para todas las funciones de IA (redacción, regeneración y
# auditoría). Solo modelos Gemini. Si está saturado, se usan respaldos.
GEMINI_MODEL=gemini-2.5-flash

# File Search Store (RAG). Vacío = creación/reutilización automática.
FILE_SEARCH_STORE_NAME=

# Puerto del servidor SSR.
PORT=4000
